# Isolated feasibility probe only. refclk/output pins are not a board design.
set_property -dict {PACKAGE_PIN E5 IOSTANDARD LVCMOS18} [get_ports RGMII_rxc]
set_property -dict {PACKAGE_PIN D5 IOSTANDARD LVCMOS18} [get_ports RGMII_rx_ctl]
set_property -dict {PACKAGE_PIN G6 IOSTANDARD LVCMOS18} [get_ports {RGMII_rd[0]}]
set_property -dict {PACKAGE_PIN F6 IOSTANDARD LVCMOS18} [get_ports {RGMII_rd[1]}]
set_property -dict {PACKAGE_PIN G8 IOSTANDARD LVCMOS18} [get_ports {RGMII_rd[2]}]
set_property -dict {PACKAGE_PIN F7 IOSTANDARD LVCMOS18} [get_ports {RGMII_rd[3]}]
set_property -dict {PACKAGE_PIN AE5 IOSTANDARD LVCMOS18} [get_ports refclk_in]
set_property IOSTANDARD LVCMOS18 [get_ports {cal_resetn data_out[*] valid_out ready_out}]
create_clock -period 2.696656 -name delay_ref [get_ports refclk_in]
create_clock -period 8.0 -name RGMII_rxc [get_ports RGMII_rxc]
set_input_delay -clock RGMII_rxc -min 0.8 [get_ports {RGMII_rd[*] RGMII_rx_ctl}]
set_input_delay -clock RGMII_rxc -max 3.2 [get_ports {RGMII_rd[*] RGMII_rx_ctl}]
set_input_delay -clock RGMII_rxc -clock_fall -add_delay -min 0.8 [get_ports {RGMII_rd[*] RGMII_rx_ctl}]
set_input_delay -clock RGMII_rxc -clock_fall -add_delay -max 3.2 [get_ports {RGMII_rd[*] RGMII_rx_ctl}]
set_false_path -to [get_pins -hier -filter {REF_PIN_NAME == CLR && NAME =~ *ready_pipe_reg*}]
set_false_path -from [get_ports cal_resetn]
